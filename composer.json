{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "algolia/algoliasearch-client-php": "^4.0",
        "arielcr/numero-a-letras": "dev-master",
        "aws/aws-sdk-php-laravel": "*",
        "barryvdh/laravel-dompdf": "*",
        "google/apiclient": "*",
        "guzzlehttp/guzzle": "^7.8|^8.2.0",
        "intervention/image": "*",
        "intervention/image-laravel": "*",
        "jpgraph/jpgraph": "*",
        "laravel/cashier": "*",
        "laravel/framework": "^13.0",
        "laravel/helpers": "*",
        "laravel/socialite": "*",
        "laravel/tinker": "*",
        "laravel/ui": "*",
        "league/flysystem-aws-s3-v3": "*",
        "maatwebsite/excel": "*",
        "mongodb/laravel-mongodb": "*",
        "phpoffice/phpspreadsheet": "*",
        "predis/predis": "*",
        "pusher/pusher-php-server": "*",
        "scssphp/scssphp": "*",
        "spatie/laravel-activitylog": "*",
        "spatie/laravel-google-calendar": "*",
        "prabowosd/laravel-collective-html": "*",
        "santigarcor/laratrust": "*",
        "tymon/jwt-auth": "*",
        "yajra/laravel-datatables-oracle": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.3.6",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "classmap": [
            "database",
            "app/Models",
            "app/Classes",
            "app/Custom"
        ],
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "symfony/thanks": true
        }
    }
}
