{
    "private": true,
    "main": "gulpfile.js",
    "browserify": {
        "transform": [
            "browserify-shim"
        ]
    },
    "browser": {
        "react-summernote": "react-summernote/dist/react-summernote.js"
    },
    "browserify-shim": {
        "jquery": "global:jquery",
        "backbone": {
            "exports": "global:Backbone",
            "depends": [
                "jquery:$"
            ]
        },
        "codemirror": "global:CodeMirror",
        "summernote/dist/summernote.js": {
            "depends": [
                "jquery:$",
                "codemirror:CodeMirror"
            ]
        },
        "summernote-cleaner/summernote-cleaner.js": {
            "depends": [
                "jquery:$"
            ]
        },
        "react-summernote": {
            "exports": "ReactSummernote",
            "depends": [
                "jquery:$",
                "codemirror:CodeMirror",
                "summernote/dist/summernote:$.fn.summernote"
            ]
        },
        "react-summernote/lang/summernote-es-ES.js": {
            "depends": [
                "jquery:jquery"
            ]
        }
    },
    "devDependencies": {
        "babel-core": "^6.26.3",
        "babel-preset-env": "^1.7.0",
        "babel-preset-react": "^6.24.1",
        "babel-preset-stage-3": "^6.24.1",
        "browserify-shim": "^3.8.14",
        "bundle-collapser": "^1.3.0",
        "datatables.net": "^1.10.19",
        "datatables.net-dt": "^1.10.19",
        "datatables.net-select": "^1.2.7",
        "datatables.net-select-dt": "^1.2.7",
        "envify": "^4.1.0",
        "gulp": "^3.9.1",
        "laravel-elixir": "^5.0.0",
        "node-bourbon": "^4.2.8",
        "react-test-renderer": "^18.2.0",
        "uglifyify": "^5.0.2",
        "ws": "3.3.2"
    },
    "dependencies": {
        "autosize": "^4.0.2",
        "backbone": "^1.3.3",
        "backbone.paginator": "^2.0.8",
        "bootstrap": "^3.3.6",
        "bootstrap-colorpicker": "^3.0.3",
        "bootstrap-daterangepicker": "^3.0.3",
        "bootstrap-progressbar": "^0.9.0",
        "bootstrap-wysiwyg": "^2.0.1",
        "bourbon": "^4.3.4",
        "codemirror": "^5.40.0",
        "datatables.net-bs": "^1.10.19",
        "datatables.net-buttons": "^1.5.4",
        "datatables.net-buttons-bs": "^1.5.4",
        "datatables.net-fixedheader": "^3.1.5",
        "datatables.net-keytable": "^2.5.0",
        "datatables.net-responsive": "^2.2.3",
        "datatables.net-responsive-bs": "^2.2.3",
        "datatables.net-scroller": "^1.5.1",
        "datatables.net-zf": "^1.10.19",
        "dropzone": "^5.5.1",
        "echarts": "^5.4.3",
        "fastclick": "^1.0.6",
        "fine-uploader": "^5.16.2",
        "g": "^2.0.1",
        "google-code-prettify": "^1.0.5",
        "icheck": "^1.0.2",
        "image-uploader-crop": "^1.0.0",
        "inputmask": "^4.0.6",
        "jquery-jcrop": "^0.9.13",
        "jquery.hotkeys": "^0.1.0",
        "location": "0.0.1",
        "navigator": "^1.0.1",
        "npm": "^10.4.0",
        "nprogress": "^0.2.0",
        "parsley": "^0.1.0",
        "parsleyjs": "^2.8.1",
        "pnotify": "^4.0.0-beta.2",
        "prop-types": "^15.6.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-summernote": "^2.0.0",
        "select2": "^4.0.6-rc.1",
        "socket.io-client": "^2.1.1",
        "summernote-cleaner": "git+https://github.com/DiemenDesign/summernote-cleaner.git",
        "underscore": "^1.9.1",
        "validator": "^13.11.0",
        "xmlhttprequest": "^1.8.0"
    }
}
